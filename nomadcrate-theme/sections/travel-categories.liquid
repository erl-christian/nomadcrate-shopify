<section class="travel-categories">
  <div class="container">
    <div class="section-header">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>

    <div class="category-grid">

      {% for block in section.blocks %}
        <div class="category-card" {{ block.shopify_attributes }}>

          <div class="category-image-wrapper">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 600
                | image_tag: class: 'category-image', loading: 'lazy'
              }}
            {% else %}
              {%- comment -%} Fallback to dynamic placeholder if no user image is chosen {%- endcomment -%}
              {% capture placeholder_index %}{% cycle 'lifestyle-1', 'lifestyle-2', 'collection-1' %}{% endcapture %}
              {{ placeholder_index | placeholder_svg_tag: 'category-image placeholder-svg' }}
            {% endif %}
          </div>

          <div class="category-content">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.description }}</p>

            {% if block.settings.link != blank %}
              <a href="{{ block.settings.link }}" class="category-btn">
                Explore
              </a>
            {% else %}
              <a href="#" class="category-btn">
                Explore
              </a>
            {% endif %}
          </div>

        </div>
      {% endfor %}

    </div>
  </div>
</section>

{% stylesheet %}
.travel-categories {
  padding: 6rem 2rem;
  background: #f8fafc;
}

.container {
  max-width: 1300px;
  margin: 0 auto;
}

.section-header {
  text-align: center;
  margin-bottom: 3rem;
}

.section-header h2 {
  font-size: 3rem;
  margin-bottom: 1rem;
}

.section-header p {
  color: #64748b;
  font-size: 1.1rem;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rem;
}

.category-card {
  background: white;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(0,0,0,.08);
  transition: .3s ease;
  display: flex;
  flex-direction: column;
}

.category-card:hover {
  transform: translateY(-8px);
}

.category-image-wrapper {
  width: 100%;
  height: 280px;
  overflow: hidden;
  background: #e2e8f0;
}

.category-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.category-content {
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.category-content h3 {
  margin-bottom: 1rem;
}

.category-content p {
  color: #64748b;
  margin-bottom: 1.5rem;
  flex-grow: 1;
}

.category-btn {
  display: inline-block;
  background: #0f172a;
  color: white;
  padding: 10px 20px;
  border-radius: 8px;
  text-decoration: none;
  text-align: center;
  align-self: flex-start;
}

@media (max-width: 900px) {
  .category-grid {
    grid-template-columns: 1fr;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Travel Categories",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Choose Your Adventure"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Curated travel essentials for every journey."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "limit": 3,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Beach Travel"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Sun, sand, and seamless packing."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Travel Categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Beach Travel",
            "description": "Sun, sand, and seamless packing."
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Mountain Travel",
            "description": "Gear built for every elevation."
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "City Travel",
            "description": "Travel smart through urban adventures."
          }
        }
      ]
    }
  ]
}
{% endschema %}
<section class="featured-products">
  <div class="container">

    <div class="section-header">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>

    {% assign featured_collection = section.settings.featured_collection %}

    {% if featured_collection != blank %}

      <div class="products-grid">

        {% for product in featured_collection.products limit: section.settings.products_to_show %}

          <div class="product-card">

            <a href="{{ product.url }}" class="product-image-link">

              {% if product.featured_image %}
                {{
                  product.featured_image
                  | image_url: width: 800
                  | image_tag: class: 'product-image'
                }}
              {% endif %}

              {% if product.available %}
                <span class="stock-badge">
                  In Stock
                </span>
              {% else %}
                <span class="stock-badge sold-out">
                  Sold Out
                </span>
              {% endif %}

            </a>

            <div class="product-content">

              <span class="product-vendor">
                {{ product.vendor }}
              </span>

              <h3>{{ product.title }}</h3>

              {% if product.compare_at_price > product.price %}
                <div class="product-pricing">
                  <span class="sale-price">
                    {{ product.price | money }}
                  </span>

                  <span class="compare-price">
                    {{ product.compare_at_price | money }}
                  </span>
                </div>
              {% else %}
                <p class="product-price">
                  {{ product.price | money }}
                </p>
              {% endif %}

              <a href="{{ product.url }}" class="product-btn">
                View Product
              </a>

            </div>

          </div>

        {% endfor %}

      </div>

    {% else %}

      <div class="empty-state">
        <h3>No Collection Selected</h3>
        <p>Select a collection in the Theme Editor.</p>
      </div>

    {% endif %}

  </div>
</section>

{% stylesheet %}

.featured-products {
  padding: 6rem 2rem;
  background: #ffffff;
}

.container {
  max-width: 1300px;
  margin: 0 auto;
}

.section-header {
  text-align: center;
  margin-bottom: 3rem;
}

.section-header h2 {
  font-size: 3rem;
  margin-bottom: 1rem;
}

.section-header p {
  color: #64748b;
  font-size: 1.1rem;
}

.products-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2rem;
}

.product-card {
  background: white;
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(0,0,0,.08);
  transition: all .3s ease;
}

.product-card:hover {
  transform: translateY(-8px);
}

.product-image-link {
  position: relative;
  display: block;
}

.product-image {
  width: 100%;
  height: 300px;
  object-fit: cover;
}

.stock-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  background: #22c55e;
  color: white;
  padding: .4rem .8rem;
  border-radius: 100px;
  font-size: .75rem;
  font-weight: 600;
}

.stock-badge.sold-out {
  background: #ef4444;
}

.product-content {
  padding: 1.5rem;
}

.product-vendor {
  display: block;
  color: #64748b;
  font-size: .8rem;
  text-transform: uppercase;
  letter-spacing: .05em;
  margin-bottom: .75rem;
}

.product-content h3 {
  margin-bottom: 1rem;
  line-height: 1.4;
}

.product-pricing {
  display: flex;
  gap: .75rem;
  align-items: center;
  margin-bottom: 1.25rem;
}

.sale-price {
  font-weight: 700;
  font-size: 1.1rem;
}

.compare-price {
  color: #94a3b8;
  text-decoration: line-through;
}

.product-price {
  font-weight: 700;
  font-size: 1.1rem;
  margin-bottom: 1.25rem;
}

.product-btn {
  display: inline-block;
  background: #0f172a;
  color: white;
  text-decoration: none;
  padding: .8rem 1.2rem;
  border-radius: 10px;
  transition: .3s ease;
}

.product-btn:hover {
  background: #1e293b;
}

.empty-state {
  text-align: center;
  padding: 4rem 2rem;
  background: #f8fafc;
  border-radius: 20px;
}

@media (max-width: 1100px) {
  .products-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 700px) {
  .products-grid {
    grid-template-columns: 1fr;
  }
}

{% endstylesheet %}

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Traveler Favorites"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Essential gear for every journey."
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Featured Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products To Show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}